#!/usr/bin/env python3
"""
Extract process facts from the observed target over a time window.

Heimdall reports how the work went, not whether the code is good. This script
does the counting; the agent does the interpreting. That division is deliberate:
a process report is mostly numbers, and a model that tallies its own commits
will eventually get one wrong and discredit the whole document.

It measures three things and judges none of them:

  throughput  how much moved
  waste       how much was redone or thrown away
  discipline  signals only — whether docs and tests moved with the code, and in
              what order. What *should* have happened is not encoded here,
              because it is not yet decided.

Usage:
  bin/window-facts --since "last week"
  bin/window-facts --since "midnight" --until "now"
  bin/window-facts --since "2 days ago" --ref main
  bin/window-facts --since "1 hour ago" --all      # every branch; no net churn

JSON on stdout, a readable summary on stderr.
"""

import argparse
import json
import re
import statistics
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "bin"))
from classify import kind  # noqa: E402
SEP = "\x1e"  # field separator
REC = "\x1d"  # record separator

REVERT_RE = re.compile(r"^revert\b", re.I)
FIXUP_RE = re.compile(
    r"^(fixup!|squash!|amend!)|^(wip|oops|typo|nit|whoops)\b|"
    r"\b(fix (lint|typo|test|build|ci)|forgot|missed|address (review|comments))\b",
    re.I,
)


def target_git(*args):
    """Read the target through the sanctioned path."""
    proc = subprocess.run(
        [str(ROOT / "bin" / "target-git"), *args],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        sys.exit(proc.returncode)
    return proc.stdout


def resolve(expr):
    """Turn a date expression into epoch seconds, so a window has a length.

    Pure Python on purpose. This used to shell out to `date -d`, which is a GNU
    extension: BSD date, which is what macOS ships, rejects it outright. Every
    window-based extractor carried the same call, so on macOS every --since
    failed — ISO dates included — and the whole frame was unusable. Reported
    from a plugin run there.

    Accepts what the skills and rules actually pass: ISO dates and datetimes,
    `N unit ago`, `now`, `today`, `yesterday`, and a bare epoch.
    """
    import re as _re
    from datetime import datetime, timedelta, timezone
    s = str(expr).strip().lower()
    now = datetime.now(timezone.utc)

    if s in ("now", "today"):
        return int(now.timestamp())
    if s == "yesterday":
        return int((now - timedelta(days=1)).timestamp())
    if _re.fullmatch(r"@?\d{9,}", s):
        return int(s.lstrip("@"))

    m = _re.fullmatch(r"(\d+)\s+(second|minute|hour|day|week|month|year)s?\s+ago", s)
    if m:
        n, unit = int(m.group(1)), m.group(2)
        days = {"day": 1, "week": 7, "month": 30, "year": 365}
        if unit in days:
            return int((now - timedelta(days=n * days[unit])).timestamp())
        secs = {"second": 1, "minute": 60, "hour": 3600}
        return int((now - timedelta(seconds=n * secs[unit])).timestamp())

    iso = str(expr).strip().replace("Z", "+00:00")
    for fmt in (None, "%Y-%m-%d", "%Y-%m-%d %H:%M:%S", "%Y/%m/%d"):
        try:
            dt = datetime.fromisoformat(iso) if fmt is None else datetime.strptime(iso, fmt)
        except ValueError:
            continue
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return int(dt.timestamp())

    sys.exit(f"window-facts: could not resolve date {expr!r}. Accepted: an ISO date, "
             f"'N days|weeks|months|years ago', 'now', 'today', 'yesterday'.")


def classify(path):
    # The shared definition; "noise" is a fourth kind and is simply not one of
    # the three the discipline signals read.
    return kind(path)


def collect(since, until, ref, all_refs):
    def window_args(fmt, numstat):
        a = ["log", f"--format={fmt}", f"--since={since}"]
        if numstat:
            a.insert(1, "--numstat")
        if until:
            a.append(f"--until={until}")
        a.append("--all" if all_refs else ref)
        return a

    # REC leads each record rather than trailing it: --numstat prints the file
    # stats *after* the format string, so a trailing terminator would hand each
    # commit's stats to the next record. %s is single-line by definition, so the
    # header survives a partition on the first newline.
    fmt = REC + SEP.join(["%H", "%at", "%an", "%P", "%s"])
    # Bodies are fetched separately: %b may contain blank lines, which would be
    # indistinguishable from the gap before the numstat block.
    bodies = {}
    for chunk in target_git(*window_args(REC + "%H" + SEP + "%b", False)).split(REC):
        if not chunk.strip():
            continue
        sha, _, body = chunk.partition(SEP)
        bodies[sha.strip()] = body.strip()

    commits = []
    for chunk in target_git(*window_args(fmt, True)).split(REC):
        if not chunk.strip():
            continue
        head, _, stat_block = chunk.partition("\n")
        parts = head.split(SEP)
        if len(parts) < 5:
            continue
        sha, ts, author, parents, subject = parts[:5]
        body = bodies.get(sha, "")
        files = []
        for line in stat_block.splitlines():
            bits = line.split("\t")
            if len(bits) != 3:
                continue
            added, deleted, path = bits
            # binary files report "-"
            files.append({
                "path": path,
                "added": int(added) if added.isdigit() else 0,
                "deleted": int(deleted) if deleted.isdigit() else 0,
            })
        commits.append({
            "sha": sha,
            "at": int(ts),
            "author": author,
            "parents": parents.split() if parents else [],
            "subject": subject,
            "body": body.strip(),
            "files": files,
        })
    commits.sort(key=lambda c: c["at"])
    return commits


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def build(commits, since, until, ref, all_refs, typed=None):
    """`since` and `until` are resolved ISO instants, not date expressions.

    git parses a bare date differently from an explicit timestamp — measured on
    one real repository, --since=2026-06-02 and --since=2026-06-02T00:00:00Z
    differed by a day and a half of commits. Resolving both bounds up front and
    passing instants everywhere is what makes a window and its baseline
    comparable; otherwise the two halves are measured by different rules.
    """
    facts = {
        "window": {
            "since": (typed or {}).get("since", since),
            "until": (typed or {}).get("until", until),
            "since_resolved": since,
            "until_resolved": until,
            "ref": "--all" if all_refs else ref,
            "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        }
    }

    if not commits:
        facts["throughput"] = {"commits": 0}
        facts["note"] = "No commits in this window."
        return facts

    non_merge = [c for c in commits if len(c["parents"]) < 2]
    churn = {c["sha"]: sum(f["added"] + f["deleted"] for f in c["files"]) for c in commits}
    gross = sum(churn.values())
    added = sum(f["added"] for c in commits for f in c["files"])
    deleted = sum(f["deleted"] for c in commits for f in c["files"])

    touches = Counter(f["path"] for c in commits for f in c["files"])
    span = commits[-1]["at"] - commits[0]["at"]

    facts["throughput"] = {
        "commits": len(commits),
        "merge_commits": len(commits) - len(non_merge),
        "files_touched": len(touches),
        "lines_added": added,
        "lines_deleted": deleted,
        "gross_churn": gross,
        "authors": sorted({c["author"] for c in commits}),
        "first_commit_at": iso(commits[0]["at"]),
        "last_commit_at": iso(commits[-1]["at"]),
        "span_hours": round(span / 3600, 1),
        "active_days": len({iso(c["at"])[:10] for c in commits}),
    }

    # ---- distribution: was this steady, or one big drop? ----
    sizes = sorted((churn[c["sha"]] for c in non_merge), reverse=True)
    by_day = Counter(iso(c["at"])[:10] for c in commits)
    by_hour = Counter(int(iso(c["at"])[11:13]) for c in commits)
    facts["distribution"] = {
        "largest_commit_churn": sizes[0] if sizes else 0,
        "largest_commit_share": round(sizes[0] / gross, 3) if gross and sizes else 0.0,
        "top3_share": round(sum(sizes[:3]) / gross, 3) if gross else 0.0,
        "median_commit_churn": int(statistics.median(sizes)) if sizes else 0,
        "mean_commit_churn": round(statistics.fmean(sizes), 1) if sizes else 0.0,
        "commits_by_day": dict(sorted(by_day.items())),
        "commits_by_hour_utc": {str(h): by_hour[h] for h in sorted(by_hour)},
    }

    # ---- waste: what got redone ----
    # There is deliberately no "rework commit ratio" here. It read 84-98% on
    # every real window measured: at any scale most commits touch a file some
    # earlier commit touched, so it reports the existence of iteration rather
    # than the cost of it. gross/net is the honest waste signal.
    repeats = {p: n for p, n in touches.items() if n > 1}

    waste = {
        "files_touched_more_than_once": len(repeats),
        "most_touched": sorted(repeats.items(), key=lambda kv: -kv[1])[:15],
        "revert_commits": sum(1 for c in commits if REVERT_RE.search(c["subject"])),
        "fixup_like_commits": sum(1 for c in commits if FIXUP_RE.search(c["subject"])),
    }

    # Net churn needs well-defined boundaries, which --all does not give.
    if not all_refs:
        base = target_git("rev-list", "-1", f"--before={since}", ref).strip()
        head = commits[-1]["sha"]
        if base:
            net = 0
            for line in target_git("diff", "--numstat", f"{base}..{head}").splitlines():
                bits = line.split("\t")
                if len(bits) == 3:
                    a, d, _ = bits
                    net += (int(a) if a.isdigit() else 0) + (int(d) if d.isdigit() else 0)
            waste["net_churn"] = net
            waste["gross_to_net_ratio"] = round(gross / net, 2) if net else None
            waste["net_churn_basis"] = f"{base[:12]}..{head[:12]}"
        else:
            waste["net_churn"] = None
            waste["net_churn_basis"] = "no commit on this ref before the window"
    else:
        waste["net_churn"] = None
        waste["net_churn_basis"] = "not computed across --all (no single boundary)"

    facts["waste"] = waste

    # ---- discipline signals: facts only, no expectations ----
    kind_churn = defaultdict(int)
    kind_files = defaultdict(set)
    first_touch = {}
    for c in commits:
        for f in c["files"]:
            k = classify(f["path"])
            kind_churn[k] += f["added"] + f["deleted"]
            kind_files[k].add(f["path"])
            first_touch.setdefault(k, c["at"])

    code_at, doc_at, test_at = (first_touch.get(k) for k in ("code", "doc", "test"))
    subjects = [c["subject"] for c in commits]

    facts["discipline_signals"] = {
        "code_churn": kind_churn["code"],
        "doc_churn": kind_churn["doc"],
        "test_churn": kind_churn["test"],
        "doc_files_changed": len(kind_files["doc"]),
        "test_files_changed": len(kind_files["test"]),
        "doc_to_code_churn_ratio": (
            round(kind_churn["doc"] / kind_churn["code"], 3) if kind_churn["code"] else None
        ),
        "test_to_code_churn_ratio": (
            round(kind_churn["test"] / kind_churn["code"], 3) if kind_churn["code"] else None
        ),
        "first_doc_change_at": iso(doc_at) if doc_at else None,
        "first_code_change_at": iso(code_at) if code_at else None,
        "docs_preceded_code": (
            None if not (doc_at and code_at) else doc_at <= code_at
        ),
        "tests_preceded_code": (
            None if not (test_at and code_at) else test_at <= code_at
        ),
        "mean_subject_length": round(statistics.fmean(len(s) for s in subjects), 1),
        "subjects_under_15_chars": sum(1 for s in subjects if len(s) < 15),
        "commits_with_body": sum(1 for c in commits if c["body"]),
    }
    facts["discipline_signals"]["_note"] = (
        "Signals only. Nothing here is a violation: no best practices are defined yet."
    )
    return facts


# Counts scale with window size, so they compare as a multiplier. Ratios are
# already normalised, so they compare as a difference. The key name says which.
COUNT_METRICS = [
    ("throughput", "commits"),
    ("throughput", "files_touched"),
    ("throughput", "gross_churn"),
    ("throughput", "active_days"),
    ("distribution", "median_commit_churn"),
    ("waste", "files_touched_more_than_once"),
    ("discipline_signals", "code_churn"),
    ("discipline_signals", "doc_churn"),
    ("discipline_signals", "test_churn"),
]
RATIO_METRICS = [
    ("distribution", "largest_commit_share"),
    ("distribution", "top3_share"),
    ("waste", "gross_to_net_ratio"),
    ("discipline_signals", "doc_to_code_churn_ratio"),
    ("discipline_signals", "test_to_code_churn_ratio"),
]


def compare(cur, base):
    """Current against baseline, with the arithmetic already done."""
    out = {}
    for section, key in COUNT_METRICS:
        c = cur.get(section, {}).get(key)
        b = base.get(section, {}).get(key)
        if c is None or b is None:
            continue
        out[key] = {"current": c, "baseline": b,
                    "ratio": round(c / b, 2) if b else None}
    for section, key in RATIO_METRICS:
        c = cur.get(section, {}).get(key)
        b = base.get(section, {}).get(key)
        if c is None or b is None:
            continue
        out[key] = {"current": c, "baseline": b, "delta": round(c - b, 3)}
    return out


def summarise_comparison(cmp_, base_window):
    rows = [f"baseline {base_window['since_resolved'][:10]} .. "
            f"{base_window['until_resolved'][:10]} (same length, immediately prior)",
            f"  {'metric':<28} {'current':>12} {'baseline':>12}  change"]
    for key, v in cmp_.items():
        if "ratio" in v:
            chg = "—" if v["ratio"] is None else f"x{v['ratio']}"
        else:
            chg = f"{v['delta']:+}"
        rows.append(f"  {key:<28} {str(v['current']):>12} {str(v['baseline']):>12}  {chg}")
    return "\n".join(rows)


def summarise(f):
    w, out = f["window"], []
    out.append(
        f"window   {w['since_resolved']} .. {w['until_resolved']}  on {w['ref']}"
        + ("" if w["since"] == w["since_resolved"] else f"   (typed: {w['since']} .. {w['until']})")
    )
    t = f["throughput"]
    if not t.get("commits"):
        out.append("no commits in this window.")
        return "\n".join(out)

    out.append(
        f"through  {t['commits']} commits ({t['merge_commits']} merges), "
        f"{t['files_touched']} files, +{t['lines_added']}/-{t['lines_deleted']} "
        f"= {t['gross_churn']} gross churn"
    )
    out.append(
        f"         {', '.join(t['authors'])} over {t['span_hours']}h, "
        f"{t['active_days']} active day(s)"
    )
    d = f["distribution"]
    out.append(
        f"shape    largest commit {d['largest_commit_share']:.0%} of churn, "
        f"top 3 = {d['top3_share']:.0%}, median commit {d['median_commit_churn']} lines"
    )
    busiest = sorted(d["commits_by_day"].items(), key=lambda kv: -kv[1])[:3]
    out.append(
        f"         {len(d['commits_by_day'])} active day(s); busiest "
        + ", ".join(f"{day} ({n})" for day, n in busiest)
    )
    v = f["waste"]
    ratio = v.get("gross_to_net_ratio")
    out.append(
        f"waste    {v['files_touched_more_than_once']} files touched >1x, "
        f"{v['revert_commits']} revert(s), {v['fixup_like_commits']} fixup-like"
    )
    out.append(
        f"         gross/net = {ratio}"
        if ratio is not None else f"         net churn: {v['net_churn_basis']}"
    )
    s = f["discipline_signals"]
    out.append(
        f"trail    code {s['code_churn']} / doc {s['doc_churn']} / test {s['test_churn']} lines; "
        f"{s['doc_files_changed']} doc file(s), {s['test_files_changed']} test file(s)"
    )
    out.append(
        f"         docs before code: {s['docs_preceded_code']}, "
        f"tests before code: {s['tests_preceded_code']}"
    )
    out.append(
        f"         mean subject {s['mean_subject_length']} chars, "
        f"{s['commits_with_body']}/{t['commits']} with a body"
    )
    out.append("(signals only — no best practices are defined, so nothing here is a finding)")
    return "\n".join(out)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--since", required=True, help="git date expression, e.g. 'last week'")
    p.add_argument("--until", default=None, help="git date expression; defaults to now")
    p.add_argument("--ref", default=None, help="branch to read; defaults to the target's HEAD")
    p.add_argument("--all", action="store_true", dest="all_refs",
                   help="every branch (net churn is then not computable)")
    p.add_argument("--baseline", action="store_true",
                   help="also measure the equally long window immediately before, "
                        "and compare. Absolute figures mean little on their own; "
                        "the target's own history is the only honest yardstick.")
    a = p.parse_args()

    ref = a.ref
    if not ref:
        meta = ROOT / ".heimdall" / "target.json"
        ref = json.loads(meta.read_text())["defaultBranch"] if meta.exists() else "HEAD"

    start, end = resolve(a.since), resolve(a.until or "now")
    since_iso, until_iso = iso(start), iso(end)
    typed = {"since": a.since, "until": a.until or "now"}

    facts = build(collect(since_iso, until_iso, ref, a.all_refs),
                  since_iso, until_iso, ref, a.all_refs, typed)
    text = summarise(facts)

    if a.baseline:
        length = end - start
        if length <= 0:
            sys.exit("window-facts: --baseline needs a window with positive length")
        b_since, b_until = iso(start - length), since_iso
        base = build(collect(b_since, b_until, ref, a.all_refs),
                     b_since, b_until, ref, a.all_refs)
        facts["baseline"] = base
        if base["throughput"].get("commits"):
            facts["comparison"] = compare(facts, base)
            text += "\n" + summarise_comparison(facts["comparison"], base["window"])
        else:
            facts["comparison"] = None
            text += "\nbaseline {} .. {}: no commits, nothing to compare against.".format(
                b_since[:10], b_until[:10])

    print(json.dumps(facts, indent=2))
    sys.stderr.write(text + "\n")


if __name__ == "__main__":
    main()
